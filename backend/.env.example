# ---------------------------------------------------------------------------
# Backend (FastAPI) environment variables.
# On Render/Railway set these in the dashboard. Locally, copy to backend/.env
# (or export them) before running `npm run dev:api`.
# ---------------------------------------------------------------------------

# Required for live AI trip plans. Without it the API still runs but returns a
# built-in DEMO plan instead of a real OpenAI result.
OPENAI_API_KEY=

# Optional — model used for trip planning. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated PRODUCTION frontend origin(s) allowed by CORS, e.g.
#   ALLOWED_ORIGINS=https://ecotrail.vercel.app
# Localhost dev origins are always allowed automatically.
ALLOWED_ORIGINS=
