# ---------------------------------------------------------------------------
# Frontend (Vite) environment variables.
# Copy this file to `.env.local` and fill in the values you need.
# ---------------------------------------------------------------------------

# Base URL of the deployed FastAPI backend (the AI trip planner).
# Leave EMPTY for local development — Vite proxies /api -> 127.0.0.1:8000.
# In production set it to your deployed backend, e.g.
#   VITE_API_BASE_URL=https://ecotrail-api.onrender.com
VITE_API_BASE_URL=
